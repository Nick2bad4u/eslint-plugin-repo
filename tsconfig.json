{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "assumeChangesOnlyAffectDirectDependencies": true,
        "declaration": true,
        "disableSizeLimit": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "newLine": "crlf",
        "paths": {
            "@assets/*": [
                "./assets/*"
            ],
            "@plugin/*": [
                "./src/*"
            ]
        },
        "preserveConstEnums": true,
        "sourceMap": true,
        "tsBuildInfoFile": "./.cache/tsbuildinfo/tsconfig.app.tsbuildinfo",
        "types": [
            "vite/client",
            "vitest/globals"
        ]
    },
    "exclude": [
        ".cache/**",
        "coverage/**",
        "dist/**",
        "docs/docusaurus/.docusaurus/**",
        "docs/docusaurus/build/**",
        "eslint.config.bundled_*.mjs",
        "node_modules/**",
        "test/fixtures/**"
    ],
    "extends": "tsconfig-nick2bad4u/tsconfig.bundler.json",
    "include": [
        "src/**/*.d.ts",
        "src/**/*.ts",
        "test/**/*.d.ts",
        "test/**/*.ts",
        "vitest.config.ts",
        "vitest.stryker.config.ts"
    ],
    "typeAcquisition": {
        "enable": true,
        "exclude": [],
        "include": []
    },
    "watchOptions": {
        "excludeDirectories": [
            "**/node_modules",
            ".cache",
            ".coverage",
            ".git",
            ".husky",
            ".vscode",
            "_build",
            "dist/*",
            "out/*",
            "release/*",
            "temp/*"
        ],
        "excludeFiles": [],
        "fallbackPolling": "dynamicPriority",
        "synchronousWatchDirectory": true,
        "watchDirectory": "useFsEvents",
        "watchFile": "useFsEvents"
    }
}
