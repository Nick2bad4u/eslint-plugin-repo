{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "tsBuildInfoFile": "./.cache/tsbuildinfo/tsconfig.build.tsbuildinfo",
        "types": [
            "node"
        ]
    },
    "exclude": [
        ".cache/**",
        "dist/**",
        "docs/docusaurus/.docusaurus/**",
        "docs/docusaurus/build/**",
        "eslint.config.bundled_*.mjs",
        "node_modules/**",
        "test/**"
    ],
    "extends": [
        "./tsconfig.json",
        "tsconfig-nick2bad4u/tsconfig.library.json"
    ],
    "include": [
        "src/**/*.d.ts",
        "src/**/*.ts"
    ]
}
